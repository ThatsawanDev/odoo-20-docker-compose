<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_gantt_compact_view_adv.Contoller" owl="1">
        <div class="o_gantt_view h-100" t-ref="this.rootRef">
            <Layout className="this.model.useSampleModel ? 'o_view_sample_data' : ''" display="this.props.display">
                <t t-set-slot="control-panel-buttons">
                    <t t-call="{{ this.props.buttonTemplate }}"/>
                </t>
                <t t-set-slot="control-panel-actions">
                    <SearchBar toggler="this.searchBarToggler"/>
                </t>
                 <t t-set-slot="control-panel-navigation-additional">
                    <t t-component="this.searchBarToggler.component" t-props="this.searchBarToggler.props"/>
                </t>
                <t t-component="this.props.Renderer" t-props="this.rendererProps" />
            </Layout>
        </div>
    </t>

    <t t-name="web_gantt_compact_view_adv.Buttons" owl="1">
        <div class="o_crd_gantt_toolbar d-flex align-items-center flex-nowrap gap-1">
            <div class="btn-group" role="group" aria-label="Gantt navigation">
                <button class="btn btn-secondary btn-sm" t-if="!this.uiService.isSmall" aria-label="Previous" title="Previous" t-on-click="this.onPreviousClick">
                    <i class="oi" data-icon="arrow_back"/>
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="this.onTodayClick">Today</button>
                <button class="btn btn-secondary btn-sm" t-if="!this.uiService.isSmall" aria-label="Next" title="Next" t-on-click="this.onNextClick">
                    <i class="oi" data-icon="arrow_forward"/>
                </button>
            </div>
            <div class="btn-group" role="group" aria-label="Gantt scale">
                <button t-att-class="'btn btn-sm ' + (this.state.scale === 'day' ? 'btn-primary' : 'btn-secondary')" data-scale="day" t-on-click="this.onClickScale">Day</button>
                <button t-att-class="'btn btn-sm ' + (this.state.scale === 'week' ? 'btn-primary' : 'btn-secondary')" data-scale="week" t-on-click="this.onClickScale">Week</button>
                <button t-att-class="'btn btn-sm ' + (this.state.scale === 'month' ? 'btn-primary' : 'btn-secondary')" data-scale="month" t-on-click="this.onClickScale">Month</button>
                <button t-att-class="'btn btn-sm ' + (this.state.scale === 'year' ? 'btn-primary' : 'btn-secondary')" data-scale="year" t-on-click="this.onClickScale">Year</button>
            </div>
            <button accesskey="c" class="btn btn-primary btn-sm" type="button" t-on-click="this.onNewTask">Create</button>
            <div class="dropdown">
                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" aria-label="Export Gantt" t-att-aria-expanded="this.state.exportMenuOpen" t-on-click="this.onToggleExportMenu">Export</button>
                <div t-if="this.state.exportMenuOpen" class="dropdown-menu show">
                    <button class="dropdown-item" type="button" t-on-click="this.onExportPDFClick">PDF</button>
                    <button class="dropdown-item" type="button" t-on-click="this.onExportPNGClick">PNG</button>
                </div>
            </div>
            <button class="btn btn-secondary btn-sm" title="Sort" aria-label="Sort" t-on-click="this.onSortClick">
                <i class="oi" data-icon="swap_vert"/>
            </button>
        </div> 
    </t>

</templates>
