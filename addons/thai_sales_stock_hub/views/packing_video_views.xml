<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hub_packing_video_list" model="ir.ui.view">
        <field name="name">hub.packing.video.list</field>
        <field name="model">thai.sales.stock.packing.video</field>
        <field name="arch" type="xml">
            <list string="วิดีโอหลักฐานการแพ็ก" create="0" delete="0" default_order="recorded_at desc">
                <field name="recorded_at" string="วันที่บันทึก"/>
                <field name="picking_id" string="เลขใบส่ง"/>
                <field name="sale_id" string="เลขออเดอร์"/>
                <field name="hub_external_ref" string="เลขจากช่องทาง" optional="show"/>
                <field name="carrier_tracking_ref" string="เลขพัสดุ" optional="show"/>
                <field name="hub_channel_icon" widget="image" string="ไอคอน" options="{'size': [28, 28]}" optional="show"/>
                <field name="hub_channel_id" string="ช่องทาง" optional="show"/>
                <field name="partner_id" string="ลูกค้า"/>
                <field name="packer_id" string="พนักงาน"/>
                <field name="is_demo" string="ข้อมูลตัวอย่าง"/>
                <field name="station_id" string="จุดแพ็ก" optional="show"/>
                <field name="hub_packing_state" widget="badge" string="สถานะ"/>
                <field name="name" string="ไฟล์วิดีโอ" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_hub_packing_video_search" model="ir.ui.view">
        <field name="name">hub.packing.video.search</field>
        <field name="model">thai.sales.stock.packing.video</field>
        <field name="arch" type="xml">
            <search string="ค้นหาวิดีโอหลักฐาน">
                <field name="name" string="เลขออเดอร์ / เลขพัสดุ / ลูกค้า" filter_domain="['|','|','|','|',('picking_id.name','ilike',self),('sale_id.name','ilike',self),('hub_external_ref','ilike',self),('carrier_tracking_ref','ilike',self),('partner_id.name','ilike',self)]"/>
                <field name="picking_id" string="ใบส่ง"/>
                <field name="sale_id" string="ออเดอร์"/>
                <field name="partner_id" string="ลูกค้า"/>
                <field name="hub_channel_id" string="ช่องทาง"/>
                <field name="recorded_at" string="วันที่แพ็ก"/>
                <field name="packer_id" string="พนักงาน"/>
                <separator/>
                <filter name="today" string="วันนี้" domain="[('recorded_at','&gt;=',context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="packed" string="แพ็กเสร็จ" domain="[('hub_packing_state','=','packed')]"/>
                <filter name="packing" string="กำลังแพ็ก" domain="[('hub_packing_state','=','packing')]"/>
                <filter name="demo" string="ข้อมูลตัวอย่าง" domain="[('is_demo','=',True)]"/>
                <filter name="real" string="ข้อมูลจริง" domain="[('is_demo','=',False)]"/>
                <separator/>
                <filter name="group_channel" string="จัดกลุ่มตามช่องทาง" context="{'group_by':'hub_channel_id'}"/>
                <filter name="group_date" string="จัดกลุ่มตามวันที่" context="{'group_by':'recorded_at:day'}"/>
                <filter name="group_packer" string="จัดกลุ่มตามพนักงาน" context="{'group_by':'packer_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_hub_packing_video_form" model="ir.ui.view">
        <field name="name">hub.packing.video.form</field>
        <field name="model">thai.sales.stock.packing.video</field>
        <field name="arch" type="xml">
            <form string="หลักฐานวิดีโอการแพ็ก" class="o_hub_video_form" create="0" edit="0" delete="0">
                <sheet class="o_hub_video_sheet">
                    <field name="is_demo" invisible="1"/>
                    <field name="picking_state" invisible="1"/>
                    <div class="o_hub_video_hero">
                        <div class="o_hub_video_hero_icon"><i class="fa fa-cube"/></div>
                        <div><div class="o_hub_video_eyebrow">รายการแพ็กสินค้า</div><h1><field name="picking_id" readonly="1" nolabel="1"/></h1></div>
                        <div class="o_hub_video_steps">
                        <span><i class="fa fa-shopping-cart"/> รับออเดอร์ <i class="fa fa-check-circle"/></span>
                        <i class="fa fa-chevron-right"/>
                        <span><i class="fa fa-cube"/> เตรียมสินค้า <i class="fa fa-check-circle"/></span>
                        <i class="fa fa-chevron-right"/>
                        <span class="is-current"><i class="fa fa-archive"/> แพ็กสินค้า <i class="fa fa-check-circle" invisible="hub_packing_state != 'packed'"/></span>
                        <i class="fa fa-chevron-right"/>
                        <span><i class="fa fa-truck"/> จัดส่ง <i class="fa fa-check-circle" invisible="picking_state != 'done'"/></span>
                    </div>
                    </div>
                    <div class="o_hub_video_demo" invisible="not is_demo"><i class="fa fa-info-circle"/> <strong>ข้อมูลตัวอย่าง</strong> วิดีโอนี้ใช้แสดงหน้าจอ ไม่ใช่หลักฐานการจัดส่งจริง</div>
                    <div class="o_hub_video_layout">
                        <div class="o_hub_video_left">
                            <section class="o_hub_video_card">
                                <h2><i class="fa fa-clipboard"/> ข้อมูลออเดอร์</h2>
                                <div class="o_hub_video_info_grid">
                                    <div class="o_hub_video_info_col">
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-file-text-o"/> เลขออเดอร์</span><field name="sale_id" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-shopping-cart"/> เลขออเดอร์จากช่องทาง</span><field name="hub_external_ref" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-barcode"/> เลขพัสดุ</span><field name="carrier_tracking_ref" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-shopping-bag"/> ช่องทางขาย</span><div class="o_hub_video_channel"><field name="hub_channel_icon" widget="image" readonly="1" nolabel="1" options="{'size': [28, 28]}"/><field name="hub_channel_id" readonly="1" nolabel="1"/></div></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-user-o"/> ลูกค้า</span><field name="partner_id" readonly="1" nolabel="1"/></div>
                                    </div>
                                    <div class="o_hub_video_info_col">
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-calendar"/> วันที่บันทึก</span><field name="recorded_at" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-user-circle-o"/> พนักงานแพ็ก</span><field name="packer_id" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-desktop"/> จุดแพ็ก</span><field name="station_id" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-check-circle-o"/> สถานะแพ็ก</span><field name="hub_packing_state" widget="badge" readonly="1" nolabel="1"/></div>
                                        <div class="o_hub_video_info_row"><span><i class="fa fa-file-video-o"/> ชื่อไฟล์</span><field name="name" readonly="1" nolabel="1"/></div>
                                    </div>
                                </div>
                            </section>
                            <section class="o_hub_video_card o_hub_video_products">
                                <h2><i class="fa fa-cube"/> รายการสินค้า <small>(<field name="product_count" readonly="1" nolabel="1"/> รายการ)</small></h2>
                                <field name="products_html" widget="html" readonly="1" nolabel="1"/>
                            </section>
                        </div>
                        <section class="o_hub_video_card o_hub_video_player_card">
                            <h2><i class="fa fa-play-circle"/> วิดีโอหลักฐานการแพ็ก</h2>
                            <field name="video_html" widget="html" readonly="1" nolabel="1"/>
                            <button name="action_download_video" type="object" string="ดาวน์โหลดวิดีโอ" icon="fa-download" class="btn btn-primary o_hub_video_download"/>
                        </section>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hub_packing_video_history" model="ir.actions.act_window">
        <field name="name">ประวัติวิดีโอการแพ็ก</field>
        <field name="res_model">thai.sales.stock.packing.video</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hub_packing_video_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">ยังไม่มีวิดีโอหลักฐานการแพ็ก</p><p>บันทึกวิดีโอจาก Smart Packing Station แล้วรายการจะปรากฏที่นี่</p></field>
    </record>
    <record id="action_hub_packing_video_history_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_hub_packing_video_list"/>
        <field name="act_window_id" ref="action_hub_packing_video_history"/>
    </record>
    <record id="action_hub_packing_video_history_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hub_packing_video_form"/>
        <field name="act_window_id" ref="action_hub_packing_video_history"/>
    </record>
</odoo>

