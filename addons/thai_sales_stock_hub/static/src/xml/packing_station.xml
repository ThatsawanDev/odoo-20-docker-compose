<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="thai_sales_stock_hub.PackingStation">
        <div class="o_hub_station">
            <main>
                <header class="o_hub_station_header">
                    <div class="o_hub_station_heading"><i class="fa fa-cube"/><div><h1>Smart Packing Station</h1><p>สแกนออเดอร์ · ตรวจสินค้า · บันทึกวิดีโอ · ยืนยันแพ็ก</p></div></div>
                    <div class="o_hub_station_controls"><label><i class="fa fa-desktop"/> จุดแพ็ก <select t-on-change="this.selectStation" t-att-disabled="this.state.recording || this.state.saving"><option value="">เลือกจุดแพ็ก</option><option t-foreach="this.state.stations" t-as="station" t-key="station.id" t-att-value="station.id" t-att-selected="station.id === this.state.stationId"><t t-esc="station.name"/> · <t t-esc="station.warehouse"/></option></select></label><span><i class="fa fa-user"/> พนักงาน: <t t-esc="this.state.user"/></span><b class="o_hub_station_ready"><i class="fa fa-circle"/> พร้อมใช้งาน</b></div>
                </header>
                <t t-if="this.state.loading"><div class="o_hub_station_empty">กำลังโหลดคิวงานแพ็ก...</div></t>
                <t t-elif="!this.state.stations.length"><div class="o_hub_station_empty"><i class="fa fa-desktop"/><h2>ยังไม่มีจุดแพ็ก</h2><p>ให้ผู้จัดการคลังตั้งค่าจุดแพ็กก่อนเริ่มทำงาน</p><button t-if="this.state.canManageStations" t-on-click="() => this.action.doAction('thai_sales_stock_hub.action_hub_packing_stations')">ตั้งค่าจุดแพ็ก</button></div></t>
                <t t-elif="!this.state.order"><div class="o_hub_station_empty"><i class="fa fa-inbox"/><h2>ไม่มีออเดอร์รอแพ็ก</h2><p>เลือกจุดแพ็กหรือกลับไปดูคิวทั้งหมดใน Packing Control Center</p><button t-on-click="() => this.action.doAction('thai_sales_stock_hub.action_hub_packing_dashboard')">ดูคิวทั้งหมด</button></div></t>
                <t t-else="">
                    <div class="o_hub_station_grid">
                        <div class="o_hub_station_left">
                            <section class="o_hub_station_camera"><video t-ref="this.camera" autoplay="autoplay" muted="muted" playsinline="playsinline"/><div t-if="!this.state.cameraOn" class="o_hub_station_camera_placeholder"><i class="fa fa-video-camera"/><strong>ภาพจากกล้องจุดแพ็ก</strong><span>เปิดกล้องเพื่อบันทึกขั้นตอนการแพ็ก</span><button t-on-click="this.startCamera">เปิดกล้อง</button></div><div t-if="this.state.recording" class="o_hub_station_rec"><i class="fa fa-circle"/> REC <span t-if="this.state.paused">(หยุดชั่วคราว)</span></div><div class="o_hub_station_camera_footer"><span><i class="fa fa-video-camera"/> <t t-if="this.state.recording">กำลังบันทึกวิดีโอ</t><t t-elif="this.state.order.video_id">วิดีโอบันทึกแล้ว</t><t t-else="">ยังไม่ได้บันทึกวิดีโอ</t></span><span>กล่อง <t t-esc="this.state.order.box_count"/></span></div></section>
                            
                        </div>
                        <div class="o_hub_station_right">
                            <section class="o_hub_station_card o_hub_station_order"><div class="o_hub_station_card_title"><h2><i class="fa fa-clipboard"/> ออเดอร์กำลังแพ็ก</h2><div><span>ลำดับคิว <t t-esc="position"/> / <t t-esc="this.state.queue.length"/></span><button t-on-click="() => this.moveQueue(-1)" t-att-disabled="position &lt;= 1 || this.state.recording"><i class="fa fa-chevron-left"/></button><button t-on-click="() => this.moveQueue(1)" t-att-disabled="position &gt;= this.state.queue.length || this.state.recording"><i class="fa fa-chevron-right"/></button></div></div><div class="o_hub_station_order_identity"><select t-on-change="this.selectOrder" t-att-disabled="this.state.recording"><option t-foreach="this.state.queue" t-as="item" t-key="item.id" t-att-value="item.id" t-att-selected="item.id === this.state.order.id"><t t-esc="item.name"/> · <t t-esc="item.customer"/></option></select><span><img t-if="this.state.order.channel_icon" t-att-src="this.state.order.channel_icon"/> <t t-esc="this.state.order.channel"/></span><b t-esc="this.state.order.state === 'packing' ? 'กำลังแพ็ก' : 'รอแพ็ก'"/></div><div class="o_hub_station_customer"><span><i class="fa fa-user"/> <t t-esc="this.state.order.customer"/></span><span><i class="fa fa-phone"/> <t t-esc="this.state.order.phone || '—'"/></span><span><i class="fa fa-map-marker"/> <t t-esc="this.state.order.address"/></span></div><button class="o_hub_station_link" t-on-click="this.openPicking">เปิดใบส่งสินค้า <i class="fa fa-external-link"/></button></section>
                            <section class="o_hub_station_card o_hub_station_products"><div class="o_hub_station_card_title"><h2><i class="fa fa-list-alt"/> รายการสินค้า (<t t-esc="this.state.order.lines.length"/> รายการ)</h2><div class="o_hub_station_meter"><i t-att-style="'width:' + (requiredTotal ? Math.min(100, scannedTotal / requiredTotal * 100) : 0) + '%'"/></div><strong><t t-esc="scannedTotal"/> / <t t-esc="requiredTotal"/></strong></div><div class="o_hub_station_table"><table><thead><tr><th>#</th><th>รายการสินค้า</th><th>สถานะ</th></tr></thead><tbody><tr t-foreach="this.state.order.lines" t-as="line" t-key="line.id"><td t-esc="line_index + 1"/><td><div class="o_hub_station_product_main"><img t-att-src="line.image"/><div><b t-esc="line.code || line.barcode || '—'"/><span t-esc="line.name"/></div></div><div class="o_hub_station_product_qty"><span>ต้องแพ็ก <b t-esc="line.required"/></span><span>แพ็กแล้ว <b t-esc="line.scanned"/></span><span>คงเหลือ <b t-esc="Math.max(0, line.required - line.scanned)"/></span></div></td><td><span t-att-class="line.scanned &gt;= line.required ? 'done' : 'pending'"><i t-att-class="line.scanned &gt;= line.required ? 'fa fa-check-circle' : 'fa fa-circle-o'"/> <t t-esc="line.scanned &gt;= line.required ? 'ครบ' : 'รอสแกน'"/></span></td></tr></tbody></table></div></section>
                            <div class="o_hub_station_sidebar"><section class="o_hub_station_scan"><form t-on-submit="this.scan"><label><i class="fa fa-barcode"/> สแกนสินค้า</label><input t-model="this.state.barcode" placeholder="สแกน Barcode หรือพิมพ์รหัสสินค้า แล้วกด Enter" t-att-disabled="this.state.order.state !== 'packing'"/><button type="submit" t-att-disabled="this.state.order.state !== 'packing'">ตรวจรหัส</button></form><div class="o_hub_station_scan_summary"><span><i class="fa fa-cube"/> สินค้าในออเดอร์ <b><t t-esc="this.state.order.lines.length"/> รายการ</b></span><span><i class="fa fa-clone"/> จำนวนรวม <b><t t-esc="requiredTotal"/> ชิ้น</b></span><span><i class="fa fa-check-circle"/> สแกนแล้ว <b><t t-esc="scannedTotal"/> ชิ้น</b></span></div></section><section class="o_hub_station_progress o_hub_station_card"><h2><i class="fa fa-line-chart"/> ความคืบหน้าการแพ็ก</h2><div class="o_hub_station_progress_count"><strong><t t-esc="scannedTotal"/> / <t t-esc="requiredTotal"/> ชิ้น</strong><b><t t-esc="requiredTotal ? Math.round(scannedTotal / requiredTotal * 100) : 0"/>%</b></div><div class="o_hub_station_meter"><i t-att-style="'width:' + (requiredTotal ? Math.min(100, scannedTotal / requiredTotal * 100) : 0) + '%'"/></div><div class="o_hub_station_progress_stats"><span>สินค้า <b><t t-esc="this.state.order.lines.length"/> รายการ</b></span><span>สแกนแล้ว <b><t t-esc="scannedTotal"/> ชิ้น</b></span><span>กล่อง <b><t t-esc="this.state.order.box_count"/></b></span></div></section><section class="o_hub_station_boxes o_hub_station_card"><h2><i class="fa fa-cube"/> การจัดการกล่อง</h2><div class="o_hub_station_box_number">กล่องที่ <strong t-esc="this.state.order.box_count"/></div><button t-on-click="this.nextBox" t-att-disabled="this.state.recording || this.state.order.state !== 'packing'"><i class="fa fa-plus"/> เปิดกล่องใหม่</button></section></div><section class="o_hub_station_actions"><t t-if="this.state.order.state === 'waiting'"><button class="primary" t-on-click="this.startOrder"><i class="fa fa-play"/> เริ่มแพ็กออเดอร์นี้</button></t><t t-else=""><button t-if="!this.state.recording" t-on-click="this.startRecording" t-att-disabled="this.state.saving"><i class="fa fa-circle"/> เริ่มบันทึก</button><button t-if="this.state.recording" t-on-click="this.pauseRecording"><i t-att-class="this.state.paused ? 'fa fa-play' : 'fa fa-pause'"/> <t t-esc="this.state.paused ? 'บันทึกต่อ' : 'หยุดชั่วคราว'"/></button><button t-if="this.state.recording" t-on-click="this.stopRecording"><i class="fa fa-stop"/> หยุดและบันทึก</button><label class="o_hub_station_upload">อัปโหลดวิดีโอ<input type="file" accept="video/webm,video/mp4" t-on-change="this.uploadFile"/></label><button t-on-click="this.nextBox" t-att-disabled="this.state.recording"><i class="fa fa-cube"/> เปลี่ยนกล่อง</button><button class="confirm" t-on-click="this.finish" t-att-disabled="!complete || !this.state.order.video_id || this.state.recording || this.state.saving"><i class="fa fa-check"/> ยืนยันแพ็ก (จบงาน)</button></t></section>
                            <p class="o_hub_station_hint" t-if="this.state.order.state === 'packing' &amp;&amp; (!complete || !this.state.order.video_id)">ยืนยันแพ็กได้เมื่อสแกนสินค้าครบและบันทึกวิดีโอแล้ว</p>
                        </div>
                    </div>
                </t>
            </main>
        </div>
    </t>
</templates>




