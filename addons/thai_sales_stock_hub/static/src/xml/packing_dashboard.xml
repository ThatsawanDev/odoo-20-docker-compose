<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="thai_sales_stock_hub.PackingDashboard">
        <div class="o_hub_packing">
            <t t-if="this.state.loading"><div class="o_hub_packing_loading">กำลังโหลดงานแพ็ก...</div></t>
            <t t-else="">
                <main>
                    <header class="o_hub_packing_header">
                        <div><h1><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#box"/></svg> Packing Control Center</h1><p>ศูนย์ควบคุมงานแพ็กและจัดส่งจากใบส่งสินค้าจริง</p></div>
                        <div class="o_hub_packing_filters"><button t-on-click="() => this.action.doAction('thai_sales_stock_hub.action_hub_packing_station')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#barcode"/></svg> เปิด Smart Packing Station</button><span><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#calendar"/></svg> วันนี้ <t t-esc="this.state.data.date"/></span><select t-on-change="this.selectWarehouse"><option value="">คลังสินค้าทั้งหมด</option><option t-foreach="this.state.data.warehouses" t-as="w" t-key="w.id" t-att-value="w.id" t-att-selected="w.id === this.state.warehouseId"><t t-esc="w.name"/></option></select></div>
                    </header>
                    <section class="o_hub_packing_kpis">
                        <button t-on-click="() => this.action.doAction('thai_sales_stock_hub.action_hub_orders')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#cart"/></svg><span>ออเดอร์วันนี้<strong t-esc="this.count(this.state.data.orders_today)"/></span></button>
                        <button t-on-click="() => this.openQueue('waiting')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#hourglass"/></svg><span>รอแพ็ก<strong t-esc="this.count(this.state.data.stages.waiting)"/></span></button>
                        <button t-on-click="() => this.openQueue('packing')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#box"/></svg><span>กำลังแพ็ก<strong t-esc="this.count(this.state.data.stages.packing)"/></span></button>
                        <button t-on-click="() => this.openQueue('packed')"><i class="fa fa-check"/><span>แพ็กเสร็จ<strong t-esc="this.count(this.state.data.stages.packed)"/></span></button>
                        <button t-on-click="() => this.openQueue('ready')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#truck"/></svg><span>พร้อมจัดส่ง<strong t-esc="this.count(this.state.data.ready_to_ship)"/></span></button>
                        <button t-on-click="() => this.openQueue('done')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#truck"/></svg><span>จัดส่งแล้ววันนี้<strong t-esc="this.count(this.state.data.done_today)"/></span></button>
                    </section>
                    <div class="o_hub_packing_top">
                        <section class="o_hub_packing_card"><h2>สถานะการดำเนินงาน</h2><div class="o_hub_packing_flow"><button t-on-click="() => this.openQueue()"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#list"/></svg> คิวใบส่ง <b t-esc="this.count(this.state.data.open_total)"/></button><i class="fa fa-chevron-right"/><button t-on-click="() => this.openQueue('waiting')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#hourglass"/></svg> รอแพ็ก <b t-esc="this.count(this.state.data.stages.waiting)"/></button><i class="fa fa-chevron-right"/><button t-on-click="() => this.openQueue('packing')"><svg class="o_hub_icon" aria-hidden="true"><use href="/thai_sales_stock_hub/static/src/img/packing_icons.svg#box"/></svg> กำลังแพ็ก <b t-esc="this.count(this.state.data.stages.packing)"/></button><i class="fa fa-chevron-right"/><button t-on-click="() => this.openQueue('packed')"><i class="fa fa-check"/> แพ็กเสร็จ <b t-esc="this.count(this.state.data.stages.packed)"/></button></div></section>
                        <section class="o_hub_packing_card"><h2>ความคืบหน้างานแพ็ก</h2><div class="o_hub_packing_progress"><i t-att-style="'width:' + this.percent(this.state.data.open_total ? this.state.data.stages.packed / this.state.data.open_total * 100 : 0)"/></div><p>แพ็กเสร็จ <b t-esc="this.count(this.state.data.stages.packed)"/> / คิวที่ยังเปิด <b t-esc="this.count(this.state.data.open_total)"/> ใบส่งสินค้า</p></section>
                    </div>
                    <div class="o_hub_packing_bottom">
                        <section class="o_hub_packing_card"><div class="o_hub_packing_title"><h2>คิวงานแพ็ก</h2><button t-on-click="() => this.openQueue()">ดูรายการทั้งหมด <i class="fa fa-arrow-right"/></button></div><div class="o_hub_packing_tabs"><button t-att-class="this.state.stage === 'waiting' ? 'active' : ''" t-on-click="() => this.state.stage = 'waiting'">รอแพ็ก (<t t-esc="this.count(this.state.data.stages.waiting)"/>)</button><button t-att-class="this.state.stage === 'packing' ? 'active' : ''" t-on-click="() => this.state.stage = 'packing'">กำลังแพ็ก (<t t-esc="this.count(this.state.data.stages.packing)"/>)</button><button t-att-class="this.state.stage === 'packed' ? 'active' : ''" t-on-click="() => this.state.stage = 'packed'">แพ็กเสร็จ (<t t-esc="this.count(this.state.data.stages.packed)"/>)</button></div><div class="o_hub_packing_table_wrap"><table><thead><tr><th>เลขใบส่ง</th><th>ช่องทาง</th><th>ลูกค้า</th><th>รายการ</th><th>จุดแพ็ก</th><th>กำหนดส่ง</th><th>สถานะ</th></tr></thead><tbody><tr t-foreach="this.state.data.queue.filter(row => row.state === this.state.stage)" t-as="row" t-key="row.id" t-on-click="() => this.openPicking(row.id)"><td><b t-esc="row.name"/></td><td><img t-if="row.channel_icon" t-att-src="row.channel_icon"/> <t t-esc="row.channel"/></td><td t-esc="row.customer"/><td t-esc="row.items"/><td t-esc="row.station"/><td t-esc="row.deadline"/><td><span t-att-class="'stage-' + row.state" t-esc="this.stageName(row.state)"/></td></tr><tr t-if="!this.state.data.queue.some(row => row.state === this.state.stage)"><td colspan="7" class="empty">ไม่มีรายการในคิวที่แสดง <button t-on-click="() => this.openQueue(this.state.stage)">เปิดรายการทั้งหมด</button></td></tr></tbody></table></div></section>
                        <section class="o_hub_packing_card"><div class="o_hub_packing_title"><h2>ประสิทธิภาพจุดแพ็กวันนี้</h2><button t-if="this.state.data.can_manage_stations" t-on-click="this.openStations">ตั้งค่าจุดแพ็ก</button></div><table><thead><tr><th>จุดแพ็ก</th><th>พนักงาน</th><th>แพ็กแล้ว</th><th>เป้าหมาย</th><th>ความคืบหน้า</th></tr></thead><tbody><tr t-foreach="this.state.data.stations" t-as="s" t-key="s.id"><td t-esc="s.name"/><td t-esc="this.count(s.workers)"/><td t-esc="this.count(s.packed)"/><td t-esc="this.count(s.target)"/><td><div class="o_hub_packing_progress"><i t-att-style="'width:' + this.percent(s.percent)"/></div><t t-esc="s.percent"/>%</td></tr><tr t-if="!this.state.data.stations.length"><td colspan="5" class="empty">ยังไม่มีจุดแพ็กที่ตั้งค่าไว้</td></tr></tbody></table></section>
                    </div>
                </main>
            </t>
        </div>
    </t>
</templates>
