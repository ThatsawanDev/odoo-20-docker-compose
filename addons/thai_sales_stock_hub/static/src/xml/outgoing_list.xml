<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="thai_sales_stock_hub.OutgoingListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="before">
            <div class="o_hub_outgoing_summary">
                <div class="o_hub_outgoing_card"><span class="o_hub_outgoing_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4zM3 7l9 4 9-4M12 11v10"/></svg></span><span>ทั้งหมด<strong t-esc="this.outgoingSummary.all"/></span></div>
                <div class="o_hub_outgoing_card is-ready"><span class="o_hub_outgoing_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h18v11H3zM3 9l3-6h12l3 6M3 13h6l1 2h4l1-2h6"/></svg></span><span>พร้อมแพ็ก<strong t-esc="this.outgoingSummary.waiting"/></span></div>
                <div class="o_hub_outgoing_card is-packing"><span class="o_hub_outgoing_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 8v5l3 2M9 2h6"/></svg></span><span>กำลังแพ็ก<strong t-esc="this.outgoingSummary.packing"/></span></div>
                <div class="o_hub_outgoing_card is-packed"><span class="o_hub_outgoing_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg></span><span>แพ็กเสร็จ<strong t-esc="this.outgoingSummary.packed"/></span></div>
                <div class="o_hub_outgoing_card is-issue"><span class="o_hub_outgoing_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20zM12 9v5M12 17v1"/></svg></span><span>รอสินค้า / มีปัญหา<strong t-esc="this.outgoingSummary.issues"/></span></div>
            </div>
        </xpath>
    </t>
</templates>
