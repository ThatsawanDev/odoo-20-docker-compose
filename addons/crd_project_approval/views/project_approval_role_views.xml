<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="project_approval_role_view_tree" model="ir.ui.view">
        <field name="name">project.approval.role.view.tree</field>
        <field name="model">project.approval.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dept"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="project_approval_role_view_form" model="ir.ui.view">
        <field name="name">project.approval.role.view.form</field>
        <field name="model">project.approval.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="dept"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="project_approval_role_action" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">project.approval.role</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
