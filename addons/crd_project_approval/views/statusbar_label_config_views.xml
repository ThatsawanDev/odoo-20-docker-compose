<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="statusbar_label_config_view_list" model="ir.ui.view">
        <field name="name">statusbar.label.config.view.list</field>
        <field name="model">statusbar.label.config</field>
        <field name="arch" type="xml">
            <list string="Statusbar Label Configuration" editable="bottom">
                <field name="model_id"/>
                <field name="target_state_id"/>
                <field name="trigger_state_ids" widget="many2many_tags"/>
                <field name="alternative_label"/>
            </list>
        </field>
    </record>

    <record id="statusbar_label_config_view_form" model="ir.ui.view">
        <field name="name">statusbar.label.config.view.form</field>
        <field name="model">statusbar.label.config</field>
        <field name="arch" type="xml">
            <form string="Statusbar Label Configuration">
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="target_state_id"/>
                        <field name="trigger_state_ids" widget="many2many_tags"/>
                        <field name="alternative_label" placeholder="e.g. IT Review Approved"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="statusbar_label_config_action" model="ir.actions.act_window">
        <field name="name">Statusbar Label Config</field>
        <field name="res_model">statusbar.label.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
