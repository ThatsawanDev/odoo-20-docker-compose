<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_approval_settings_view_form" model="ir.ui.view">
        <field name="name">project.approval.settings.view.form</field>
        <field name="model">project.approval.settings</field>
        <field name="arch" type="xml">
            <form string="Project Approval Settings">
                <sheet>
                    <group string="Auto Assignment">
                        <field name="auto_assign_user_id"
                               options="{'no_create': True, 'no_open': True}"
                               help="User automatically assigned to signoff when submitted for review"/>
                        <field name="auto_assign_it_head_user_id"
                               options="{'no_create': True, 'no_open': True}"
                               help="User automatically assigned as IT Head approver when Business Sponsor approves"/>
                    </group>
                    <group string="Notifications">
                        <field name="send_assignment_email"
                               help="Send email to assigned user when a request is assigned for review or approval"/>
                        <field name="send_assignment_teams"
                               help="Send MS Teams message to assigned user when a request is assigned"/>
                        <field name="send_requester_notification"
                               help="Send email to the requester on every status update (in review, approved, rejected, etc.)"/>
                        <field name="ms_team_project_request"
                               placeholder="https://..."
                               help="Webhook URL for MS Teams notification on project approval request assignment"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="project_approval_open_settings_action" model="ir.actions.server">
        <field name="name">Project Approval Settings</field>
        <field name="model_id" ref="model_project_approval_settings"/>
        <field name="state">code</field>
        <field name="code">action = env['project.approval.settings'].action_open_settings()</field>
    </record>

</odoo>
