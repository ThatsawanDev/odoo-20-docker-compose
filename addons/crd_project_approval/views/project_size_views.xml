<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree/List View -->
    <record id="project_size_view_tree" model="ir.ui.view">
        <field name="name">project.size.tree</field>
        <field name="model">project.size</field>
        <field name="arch" type="xml">
            <list string="Project Sizes">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="manday_start" />
                <field name="manday_end" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="project_size_view_form" model="ir.ui.view">
        <field name="name">project.size.form</field>
        <field name="model">project.size</field>
        <field name="arch" type="xml">
            <form string="Project Size">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <!-- <field name="sequence" /> -->
                            <field name="active" invisible="True" />
                        </group>
                        <group>
                            <field name="manday_start" required="True" />
                            <field name="manday_end" required="True" />
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="project_size_action" model="ir.actions.act_window">
        <field name="name">Project Sizes</field>
        <field name="res_model">project.size</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
