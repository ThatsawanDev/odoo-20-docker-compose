<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_project_approval" model="ir.module.category">
        <field name="name">Project Approval</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_project_approval" model="res.groups.privilege">
        <field name="name">Project Approval</field>
        <field name="category_id" ref="module_category_project_approval"/>
    </record>

    <record id="group_project_approver" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_project_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
