<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_process_api_queue" model="ir.cron">
            <field name="name">Project Approval: Process API Queue</field>
            <field name="model_id" ref="model_project_approval_api_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_cleanup_api_queue" model="ir.cron">
            <field name="name">Project Approval: Cleanup Old API Queue Records</field>
            <field name="model_id" ref="model_project_approval_api_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_records()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
