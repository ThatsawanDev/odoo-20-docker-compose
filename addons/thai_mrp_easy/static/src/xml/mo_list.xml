<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="thai_mrp_easy.MrpOrderListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="before">
            <div class="o_thai_mrp_list_summary">
                <div class="o_thai_mrp_list_stat"><span class="o_thai_mrp_list_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6zM15 3v5h4M9 12h7M9 16h7"/></svg></span><span>แบบร่าง<strong t-esc="this.moSummary.draft"/></span></div>
                <div class="o_thai_mrp_list_stat"><span class="o_thai_mrp_list_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 8v5l3 2M9 2h6"/></svg></span><span>รอผลิต<strong t-esc="this.moSummary.confirmed"/></span></div>
                <div class="o_thai_mrp_list_stat"><span class="o_thai_mrp_list_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6l.5 2.2 1.7.8 2-.9 3 5-1.7 1.4v2l1.7 1.4-3 5-2-.9-1.7.8L15 22H9l-.5-2.2-1.7-.8-2 .9-3-5 1.7-1.4v-2L1.8 10l3-5 2 .9 1.7-.8z"/><circle cx="12" cy="12.5" r="3"/></svg></span><span>กำลังผลิต<strong t-esc="this.moSummary.progress"/></span></div>
                <div class="o_thai_mrp_list_stat is-warning"><span class="o_thai_mrp_list_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20zM12 9v5M12 17v1"/></svg></span><span>วัตถุดิบยังไม่พร้อม<strong t-esc="this.moSummary.material_waiting"/></span></div>
                <div class="o_thai_mrp_list_stat is-done"><span class="o_thai_mrp_list_icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg></span><span>เสร็จวันนี้<strong t-esc="this.moSummary.done_today"/></span></div>
            </div>
        </xpath>
    </t>
</templates>
