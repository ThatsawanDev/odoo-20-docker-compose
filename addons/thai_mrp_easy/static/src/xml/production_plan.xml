<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="thai_mrp_easy.ManufacturingGantt">
        <div class="o_thai_mrp_gantt">
            <header class="o_thai_mrp_gantt_header">
                <div><h1>แผนการผลิต</h1><p>ช่วงเวลาของใบงานผลิตและความคืบหน้า</p></div>
                <div class="o_thai_mrp_gantt_actions">
                    <button class="btn btn-outline-secondary" t-on-click="this.openCalendar">ปฏิทิน</button>
                    <button class="btn btn-primary" t-on-click="this.newOrder">สร้างใบงานผลิต</button>
                </div>
            </header>
            <div class="o_thai_mrp_gantt_toolbar">
                <div class="o_thai_mrp_gantt_nav">
                    <button aria-label="ก่อนหน้า" t-on-click="() => this.navigate(-1)">‹</button>
                    <button t-on-click="this.today">วันนี้</button>
                    <button aria-label="ถัดไป" t-on-click="() => this.navigate(1)">›</button>
                    <strong t-esc="this.state.title"/>
                </div>
                <div class="o_thai_mrp_gantt_scales">
                    <button t-att-class="this.state.scale === 'week' ? 'is-active' : ''" t-on-click="() => this.setScale('week')">2 สัปดาห์</button>
                    <button t-att-class="this.state.scale === 'month' ? 'is-active' : ''" t-on-click="() => this.setScale('month')">เดือน</button>
                </div>
            </div>
            <div t-if="this.state.loading" class="o_thai_mrp_gantt_empty">กำลังโหลดแผนการผลิต...</div>
            <div t-else="" class="o_thai_mrp_gantt_scroll">
                <div class="o_thai_mrp_gantt_grid" t-att-style="'--day-count:' + this.state.days.length">
                    <div class="o_thai_mrp_gantt_left_head">ใบงานผลิต / สินค้า</div>
                    <div class="o_thai_mrp_gantt_days">
                        <div t-foreach="this.state.days" t-as="day" t-key="day.iso" t-att-class="(day.weekend ? 'is-weekend ' : '') + (day.today ? 'is-today' : '')">
                            <small t-esc="day.weekday"/><b t-esc="day.day"/>
                        </div>
                    </div>
                    <t t-foreach="this.state.orders" t-as="order" t-key="order.id">
                        <button class="o_thai_mrp_gantt_order" t-on-click="() => this.openOrder(order.id)">
                            <b t-esc="order.name"/><span t-esc="order.product"/><small><t t-esc="order.quantity"/> <t t-esc="order.uom"/> · <t t-esc="order.state_label"/></small>
                        </button>
                        <div class="o_thai_mrp_gantt_track">
                            <div t-foreach="this.state.days" t-as="day" t-key="day.iso" t-att-class="'o_thai_mrp_gantt_cell ' + (day.weekend ? 'is-weekend ' : '') + (day.today ? 'is-today' : '')"/>
                            <button t-att-class="'o_thai_mrp_gantt_bar is-' + order.state" t-att-style="this.barStyle(order)" t-att-title="order.name + ' · ' + order.start + ' – ' + order.end" t-on-click="() => this.openOrder(order.id)">
                                <span t-esc="order.name"/>
                            </button>
                        </div>
                    </t>
                    <div t-if="!this.state.orders.length" class="o_thai_mrp_gantt_empty_row">
                        ยังไม่มีใบงานผลิตในช่วงนี้ · สร้างใบงานผลิตแล้วกำหนดวันที่เริ่มและสิ้นสุดเพื่อแสดงบนแผน
                    </div>
                </div>
            </div>
            <div class="o_thai_mrp_gantt_legend"><span class="is-draft">แบบร่าง</span><span class="is-confirmed">ยืนยันแล้ว</span><span class="is-progress">กำลังผลิต</span><span class="is-done">เสร็จสิ้น</span></div>
        </div>
    </t>
</templates>
