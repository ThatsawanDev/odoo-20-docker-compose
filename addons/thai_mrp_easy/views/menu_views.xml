<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_thai_manufacturing_plan" model="ir.actions.act_window">
        <field name="name">Production Plan</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_id" ref="mrp.view_production_calendar"/>
        <field name="domain">[('state', 'not in', ('done', 'cancel'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a manufacturing order to start planning.</p>
            <p>Choose a product and a bill of materials, then set the planned start and finish dates.</p>
        </field>
    </record>
    <record id="action_thai_manufacturing_gantt" model="ir.actions.client">
        <field name="name">Production Plan</field>
        <field name="tag">thai_mrp_easy.ManufacturingGantt</field>
    </record>
    <menuitem id="menu_thai_manufacturing_plan"
              name="Production Plan"
              parent="mrp.mrp_planning_menu_root"
              action="action_thai_manufacturing_gantt"
              sequence="5"/>
    <menuitem id="menu_thai_visual_bom" 
              name="Visual BOM Builder" 
              parent="mrp.menu_mrp_bom" 
              action="action_thai_visual_bom" 
              sequence="14"/>
</odoo>
