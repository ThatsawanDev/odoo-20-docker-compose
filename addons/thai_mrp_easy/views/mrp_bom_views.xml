<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_thai_visual_bom" model="ir.actions.client">
        <field name="name">Visual BOM Builder</field>
        <field name="tag">thai_mrp_easy.VisualBomBuilder</field>
    </record>

    <!-- Optional: Add a button to standard BOM form to open it in visual builder -->
    <record id="view_mrp_bom_form_thai_easy" model="ir.ui.view">
        <field name="name">mrp.bom.form.thai.easy</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button type="action" name="%(thai_mrp_easy.action_thai_visual_bom)d" string="เปิดแบบภาพ (Visual BOM)" class="btn-primary" context="{'default_bom_id': id}"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
