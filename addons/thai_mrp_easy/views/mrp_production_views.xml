<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thai_mrp_production_form" model="ir.ui.view">
        <field name="name">mrp.production.form.thai.easy</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- 1. Change Sheet to Flex Layout -->
            <xpath expr="//sheet" position="attributes">
                <attribute name="class">o_tmo_sheet</attribute>
            </xpath>

            <!-- 2. Stepper above sheet -->
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <div class="o_tmo_stepper">
                    <div class="stepper-item active">
                        <div class="step-circle">1</div>
                        <div class="step-label">
                            <div class="fw-bold">ข้อมูลใบงานผลิต</div>
                            <small class="text-muted">ระบุสินค้าและจำนวน</small>
                        </div>
                    </div>
                    <div class="stepper-line"></div>
                    <div class="stepper-item">
                        <div class="step-circle">2</div>
                        <div class="step-label">
                            <div class="fw-bold">ตรวจสอบวัตถุดิบ</div>
                            <small class="text-muted">ดูความพร้อมของวัตถุดิบ</small>
                        </div>
                    </div>
                    <div class="stepper-line"></div>
                    <div class="stepper-item">
                        <div class="step-circle">3</div>
                        <div class="step-label">
                            <div class="fw-bold">ดำเนินการผลิต</div>
                            <small class="text-muted">บันทึกการผลิต</small>
                        </div>
                    </div>
                    <div class="stepper-line"></div>
                    <div class="stepper-item">
                        <div class="step-circle">4</div>
                        <div class="step-label">
                            <div class="fw-bold">รับสินค้าสำเร็จรูป</div>
                            <small class="text-muted">เข้าสต็อก</small>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- 3. Sidebar inside sheet (flex container) -->
            <xpath expr="//sheet" position="inside">
                <div class="o_tmo_sidebar">
                    <div class="o_tmo_card">
                        <div class="d-flex mb-3 align-items-center">
                            <!-- Product Image -->
                            <div style="width: 64px; height: 64px; border: 1px solid #ddd; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden;" class="me-3 bg-light">
                                <i class="fa fa-cubes fa-2x text-muted" title="Product" invisible="product_id != False"/>
                                <field name="product_id" widget="image" options="{'preview_image': 'image_128', 'size': [64, 64]}" invisible="product_id == False" readonly="1"/>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-0 fw-bold" style="color: #2b3d51;"><field name="product_id" readonly="1" options="{'no_open': True}"/></h5>
                                <div class="text-muted small">จำนวน: <field name="product_qty" readonly="1"/> <field name="uom_id" readonly="1"/></div>
                            </div>
                        </div>
                        <div class="row text-center border-top pt-2">
                            <div class="col-6 border-end">
                                <div class="small text-muted mb-1">วันที่เริ่มผลิต</div>
                                <div class="fw-bold small"><field name="date_start" readonly="1"/></div>
                            </div>
                            <div class="col-6">
                                <div class="small text-muted mb-1">กำหนดเสร็จ</div>
                                <div class="fw-bold small"><field name="date_finished" readonly="1"/></div>
                            </div>
                        </div>
                    </div>

                    <div class="o_tmo_card">
                        <h6 class="fw-bold mb-3">ความพร้อมของวัตถุดิบ</h6>
                        <div class="d-flex justify-content-between mb-1 small fw-bold">
                            <span>สถานะ</span>
                            <span class="text-primary"><field name="easy_readiness_percent" widget="progressbar"/></span>
                        </div>
                        
                        <div class="d-flex align-items-center mb-2 small mt-3">
                            <div class="rounded-circle bg-success me-2" style="width:12px; height:12px;"></div>
                            <span class="flex-grow-1">เพียงพอ</span>
                            <span class="fw-bold"><field name="easy_stat_enough" readonly="1"/> รายการ</span>
                        </div>
                        <div class="d-flex align-items-center mb-2 small">
                            <div class="rounded-circle bg-danger me-2" style="width:12px; height:12px;"></div>
                            <span class="flex-grow-1">ไม่เพียงพอ</span>
                            <span class="fw-bold"><field name="easy_stat_missing" readonly="1"/> รายการ</span>
                        </div>
                    </div>

                    <div class="o_tmo_card is-danger" invisible="easy_stat_missing == 0">
                        <div class="text-danger fw-bold mb-2">
                            <i class="fa fa-exclamation-circle"/> วัตถุดิบที่ไม่เพียงพอ
                        </div>
                        <div class="small text-muted mb-3">คุณสามารถสร้างใบขอซื้อ (PO) สำหรับรายการที่ขาดได้ทันที</div>
                        <button name="action_easy_create_po_for_missing" type="object" class="btn btn-outline-danger btn-sm w-100 fw-bold"><i class="fa fa-shopping-cart"/> สร้างใบขอซื้อ</button>
                    </div>

                    <div class="o_tmo_card is-info">
                        <div class="d-flex">
                            <i class="fa fa-lightbulb-o text-primary fa-2x me-3"/>
                            <div class="small text-primary">
                                <strong>คำแนะนำ</strong><br/>
                                <span class="text-muted">ระบบจะคำนวณวัตถุดิบและแจ้งเตือนให้อัตโนมัติตามสูตรการผลิตที่เลือกไว้</span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- 4. Table visual enhancements -->
            <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
                <field name="easy_qty_available" string="คงเหลือสต็อก"/>
                <field name="easy_is_enough" invisible="1"/>
                <button icon="fa-check text-success" title="เพียงพอ" invisible="not easy_is_enough"/>
                <button icon="fa-times text-danger" title="ไม่เพียงพอ" invisible="easy_is_enough"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list//field[@name='product_id']" position="attributes">
                <attribute name="widget">many2one_avatar</attribute>
            </xpath>
        </field>
    </record>
</odoo>
