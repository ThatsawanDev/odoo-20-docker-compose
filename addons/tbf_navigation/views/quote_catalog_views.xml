<odoo>
    <record id="view_sale_order_form_tbf_catalog" model="ir.ui.view">
        <field name="name">sale.order.form.tbf.catalog</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="แคตตาล็อกรูปสินค้า" name="tbf_quote_catalog">
                    <group>
                        <field name="tbf_show_catalog_images" widget="boolean_toggle"/>
                    </group>
                    <field name="tbf_catalog_html" widget="html" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
