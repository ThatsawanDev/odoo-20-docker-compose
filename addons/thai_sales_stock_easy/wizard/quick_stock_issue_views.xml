<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thai_quick_stock_issue_form" model="ir.ui.view">
        <field name="name">thai.quick.stock.issue.form</field>
        <field name="model">thai.quick.stock.issue</field>
        <field name="arch" type="xml">
            <form string="เบิกสินค้าออก">
                <div class="alert alert-info" role="alert">
                    <strong>ใช้งานง่าย:</strong> ระบบจะใช้คลังหลักของบริษัทให้อัตโนมัติ ไม่ต้องเลือกคลัง
                </div>
                <group>
                    <field name="partner_id" options="{'no_create_edit': True}"/>
                    <field name="product_id" options="{'no_create_edit': True}"/>
                    <label for="quantity" string="จำนวนที่เบิก"/>
                    <div class="o_row">
                        <field name="quantity"/>
                        <field name="product_uom_id" class="oe_inline"/>
                    </div>
                    <field name="note" placeholder="เช่น เบิกใช้หน้าร้าน หรือชื่อลูกค้า"/>
                </group>
                <footer>
                    <button name="action_issue_now" string="ยืนยันและตัดสต็อก" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_thai_quick_stock_issue" model="ir.actions.act_window">
        <field name="name">เบิกสินค้าออก</field>
        <field name="res_model">thai.quick.stock.issue</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

