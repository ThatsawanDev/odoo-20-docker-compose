<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_thai_image_gallery" model="ir.ui.view">
        <field name="name">product.template.thai.image.gallery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="thai_image_gallery" string="รูปสินค้าเพิ่มเติม">
                    <p class="text-muted">รูปหลักอยู่ด้านบนของหน้าสินค้า เพิ่มรูปอื่นได้หลายรูปในรายการนี้</p>
                    <field name="thai_image_ids" nolabel="1" mode="list,form">
                        <list editable="bottom" string="รูปสินค้าเพิ่มเติม">
                            <field name="sequence" widget="handle"/>
                            <field name="image_1920" string="รูปภาพ" widget="image" options="{'size': [96, 96]}" required="1"/>
                            <field name="name" string="คำอธิบายรูป" required="1"/>
                        </list>
                        <form string="รูปสินค้าเพิ่มเติม">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="image_1920" widget="image" options="{'size': [480, 480]}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
