<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions are defined here so this app remains independent from standard menu IDs. -->
    <record id="action_quotation" model="ir.actions.act_window">
        <field name="name">Quotations</field><field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
    </record>
    <record id="action_sales_order" model="ir.actions.act_window">
        <field name="name">All Sales Orders</field><field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
    </record>
    <record id="action_purchase_rfq" model="ir.actions.act_window">
        <field name="name">Requests for Quotation / Purchase Orders</field><field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
    </record>
    <record id="action_outgoing" model="ir.actions.act_window">
        <field name="name">Outgoing Deliveries</field><field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('picking_type_id.code','=','outgoing'),('state','not in',('done','cancel'))]</field>
    </record>
    <record id="action_incoming" model="ir.actions.act_window">
        <field name="name">Incoming Receipts</field><field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="domain">[('picking_type_id.code','=','incoming'),('state','not in',('done','cancel'))]</field>
    </record>
    <record id="action_all_pickings" model="ir.actions.act_window">
        <field name="name">All Transfers</field><field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form,calendar</field>
    </record>
    <record id="action_products" model="ir.actions.act_window">
        <field name="name">Products and Stock</field><field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_storable','=',True)]</field>
    </record>
    <record id="action_customer_invoice" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field><field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
        <field name="domain">[('move_type','=','out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <record id="action_receivable" model="ir.actions.act_window">
        <field name="name">Receivables</field><field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,pivot,graph,activity</field>
        <field name="domain">[('move_type','=','out_invoice'),('state','=','posted'),('payment_state','in',('not_paid','partial'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <record id="action_customers" model="ir.actions.act_window">
        <field name="name">Customers</field><field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field><field name="domain">[('customer_rank','&gt;',0)]</field>
        <field name="context">{'default_customer_rank': 1}</field>
    </record>
    <record id="action_vendors" model="ir.actions.act_window">
        <field name="name">Vendors</field><field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field><field name="domain">[('supplier_rank','&gt;',0)]</field>
        <field name="context">{'default_supplier_rank': 1}</field>
    </record>

    <menuitem id="menu_root" name="Overview" parent="sale.sale_menu_root" sequence="5" action="action_thai_sales_stock_dashboard"/>
    <menuitem id="menu_quick_issue" name="Quick Stock Issue" parent="stock.menu_stock_warehouse_mgmt" action="action_thai_quick_stock_issue" sequence="5"/>

    <menuitem id="menu_finance" name="Billing &amp; Tax" parent="sale.sale_menu_root" sequence="30" groups="base.group_system"/>
    <menuitem id="menu_receivable" name="Receivables" parent="menu_finance" action="action_receivable" sequence="10"/>
    <menuitem id="menu_customer_invoice" name="Customer Invoices" parent="menu_finance" action="action_customer_invoice" sequence="20"/>
</odoo>
