<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tiktok_account_form" model="ir.ui.view">
        <field name="name">tiktok.account.form</field>
        <field name="model">tiktok.account</field>
        <field name="arch" type="xml">
            <form string="TikTok Shop Account">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_shops" type="object" class="oe_stat_button" icon="fa-shopping-bag">
                            <field name="shop_count" widget="statinfo" string="Shops"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. TikTok Open Application TH"/></h1>
                    </div>
                    <group>
                        <group string="API Credentials">
                            <field name="app_key"/>
                            <field name="app_secret" password="True"/>
                        </group>
                        <group string="Region Configuration">
                            <field name="region"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Connected Seller Stores" name="shops">
                            <field name="shop_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="shop_identifier"/>
                                    <field name="warehouse_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'error'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tiktok_account_list" model="ir.ui.view">
        <field name="name">tiktok.account.list</field>
        <field name="model">tiktok.account</field>
        <field name="arch" type="xml">
            <list string="TikTok Shop Accounts">
                <field name="name"/>
                <field name="app_key"/>
                <field name="region"/>
                <field name="shop_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_tiktok_account_list" model="ir.actions.act_window">
        <field name="name">Developer Accounts</field>
        <field name="res_model">tiktok.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your TikTok Shop Developer Application credentials
            </p>
        </field>
    </record>

</odoo>
