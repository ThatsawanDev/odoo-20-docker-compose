<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tiktok_webhook_event_list" model="ir.ui.view">
        <field name="name">tiktok.webhook.event.list</field>
        <field name="model">tiktok.webhook.event</field>
        <field name="arch" type="xml">
            <list string="TikTok Webhook Events" create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="shop_id"/>
                <field name="notification_id"/>
                <field name="event_type"/>
                <field name="order_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'pending'"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_tiktok_webhook_event_form" model="ir.ui.view">
        <field name="name">tiktok.webhook.event.form</field>
        <field name="model">tiktok.webhook.event</field>
        <field name="arch" type="xml">
            <form string="TikTok Webhook Event" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="notification_id"/>
                            <field name="shop_id"/>
                            <field name="order_id"/>
                        </group>
                        <group>
                            <field name="event_type"/>
                            <field name="state"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="error_message"/>
                        <field name="payload" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tiktok_webhook_event_list" model="ir.actions.act_window">
        <field name="name">Webhook Events</field>
        <field name="res_model">tiktok.webhook.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
