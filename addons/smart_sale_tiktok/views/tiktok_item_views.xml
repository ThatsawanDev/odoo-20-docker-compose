<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tiktok_item_list" model="ir.ui.view">
        <field name="name">tiktok.item.list</field>
        <field name="model">tiktok.item</field>
        <field name="arch" type="xml">
            <list string="TikTok Mapped SKUs" editable="bottom">
                <field name="shop_id"/>
                <field name="name"/>
                <field name="tiktok_product_id"/>
                <field name="tiktok_sku_id"/>
                <field name="product_id"/>
                <field name="sync_stock" widget="boolean_toggle"/>
                <field name="last_synced_quantity"/>
                <field name="last_inventory_sync_date"/>
                <field name="last_inventory_sync_error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_tiktok_item_list" model="ir.actions.act_window">
        <field name="name">Mapped Items &amp; SKUs</field>
        <field name="res_model">tiktok.item</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
