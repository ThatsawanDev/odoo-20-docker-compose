<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tiktok_shop_form" model="ir.ui.view">
        <field name="name">tiktok.shop.form</field>
        <field name="model">tiktok.shop</field>
        <field name="arch" type="xml">
            <form string="TikTok Shop Store">
                <header>
                    <button name="action_authorize" string="Authorize OAuth Connection" type="object" class="oe_highlight" invisible="state == 'active'"/>
                    <button name="action_sync_orders_now" string="Sync Orders Now" type="object" class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_sync_inventory_now" string="Sync Inventory Now" type="object" class="btn-secondary" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Official TikTok Store TH"/></h1>
                    </div>
                    <group>
                        <group string="Store Setup">
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="team_id"/>
                        </group>
                        <group string="Identifiers &amp; OAuth Status">
                            <field name="shop_identifier" readonly="1"/>
                            <field name="shop_cipher" readonly="1"/>
                            <field name="access_token_expiration_date" readonly="1"/>
                            <field name="webhook_url" readonly="1" widget="CopyClipboardChar"/>
                        </group>
                    </group>
                    <group string="Automated Synchronizations">
                        <group>
                            <field name="sync_orders"/>
                            <field name="last_orders_sync_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="sync_inventory"/>
                            <field name="last_inventory_sync_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mapped SKUs" name="items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="tiktok_product_id"/>
                                    <field name="tiktok_sku_id"/>
                                    <field name="product_id"/>
                                    <field name="sync_stock" widget="boolean_toggle"/>
                                    <field name="last_synced_quantity"/>
                                    <field name="last_inventory_sync_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tiktok_shop_list" model="ir.ui.view">
        <field name="name">tiktok.shop.list</field>
        <field name="model">tiktok.shop</field>
        <field name="arch" type="xml">
            <list string="TikTok Shops">
                <field name="name"/>
                <field name="account_id"/>
                <field name="warehouse_id"/>
                <field name="last_orders_sync_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="action_tiktok_shop_list" model="ir.actions.act_window">
        <field name="name">Seller Stores</field>
        <field name="res_model">tiktok.shop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect and manage your TikTok Shop seller stores
            </p>
        </field>
    </record>

</odoo>
