<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_mcp_studio" model="res.groups.privilege">
        <field name="name">MCP Studio</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_mcp_admin" model="res.groups">
        <field name="name">MCP Admin</field>
        <field name="privilege_id" ref="module_mcp_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="group_mcp_user" model="res.groups">
        <field name="name">MCP User</field>
        <field name="privilege_id" ref="module_mcp_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
