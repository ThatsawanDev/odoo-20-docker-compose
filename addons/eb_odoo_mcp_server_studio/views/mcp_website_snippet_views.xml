    <record id="action_mcp_snippet" model="ir.actions.act_window">
        <field name="name">Website Snippets</field>
        <field name="res_model">mcp.snippet</field>
        <field name="view_mode">kanban,list,form</field>
<!--        <field name="search_view_id" ref="view_mcp_snippet_search"/>-->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No snippets yet — ask AI to build one!
            </p>
