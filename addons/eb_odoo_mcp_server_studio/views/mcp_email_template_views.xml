<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ──────────────────────────────────────────────────── -->
    <record id="view_mcp_email_template_list" model="ir.ui.view">
        <field name="name">mcp.email.template.list</field>
        <field name="model">mcp.email.template</field>
        <field name="arch" type="xml">
            <list string="Email Templates"
                  decoration-success="state == 'ready' or state == 'tested'"
                  decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="model" optional="show"/>
                <field name="subject"/>
                <field name="mail_template_id" optional="show"/>
                <field name="mass_mailing_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ('ready','tested')"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'archived'"/>
                <field name="write_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────── -->
    <record id="view_mcp_email_template_form" model="ir.ui.view">
        <field name="name">mcp.email.template.form</field>
        <field name="model">mcp.email.template</field>
        <field name="arch" type="xml">
            <form string="Email Template">
                <header>
                    <!-- Primary CTA: Generate (only when no linked template yet) -->
                    <button name="action_generate_template"
                            type="object"
                            string="⚡ Generate Template"
                            class="oe_highlight"
                            invisible="not model_id or mail_template_id"/>
                    <!-- Re-Sync when linked template exists -->
                    <button name="action_generate_template"
                            type="object"
                            string="🔄 Re-Sync Template"
                            class="btn-secondary"
                            invisible="not mail_template_id"/>
                    <!-- Open linked Odoo mail.template -->
                    <button name="action_open_mail_template"
                            type="object"
                            string="📧 Open in Odoo"
                            class="btn-secondary"
                            invisible="not mail_template_id"/>
                    <!-- Create Mass Mailing campaign from this template -->
                    <button name="action_create_mass_mailing"
                            type="object"
                            string="📢 Create Mass Mailing"
                            class="btn-secondary"
                            invisible="not mail_template_id or mass_mailing_id"/>
                    <!-- Open existing Mass Mailing campaign -->
                    <button name="action_open_mass_mailing"
                            type="object"
                            string="📊 Open Mass Mailing"
                            class="btn-secondary"
                            invisible="not mass_mailing_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,tested"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Email Settings">
                            <field name="subject"
                                   placeholder="Subject — supports {{ object.name }}"/>
                            <field name="email_from"
                                   placeholder="{{ user.email_formatted }}"/>
                            <field name="email_to"
                                   placeholder="{{ object.email }} or static address"/>
                        </group>
                        <group string="Odoo Integration">
                            <field name="model_id"
                                   placeholder="Set to use {{ object.field }} in body"/>
                            <field name="model" readonly="1"/>
                            <field name="mail_template_id" readonly="1"/>
                            <field name="mass_mailing_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Preview" name="preview">
                            <div class="alert alert-info d-flex align-items-center gap-2 mb-2" role="alert" style="font-size:12px;padding:8px 12px;">
                                <i class="fa fa-info-circle" title="Info"/>
                                This is a read-only visual preview. Click <strong>Open in Odoo</strong> above to edit it in the Odoo mail template editor.
                            </div>
                            <field name="body_html"
                                   widget="html"
                                   readonly="1"
                                   style="min-height:300px; border:1px solid #e2e3e9; border-radius:8px; padding:16px; background:#fff;"/>
                        </page>
                        <page string="HTML Source" name="body">
                            <field name="body_html"
                                   widget="ace"
                                   options="{'mode': 'xml'}"
                                   style="min-height:320px;"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_email_template_kanban" model="ir.ui.view">
        <field name="name">mcp.email.template.kanban</field>
        <field name="model">mcp.email.template</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="name"/>
                <field name="subject"/>
                <field name="model"/>
                <field name="state"/>
                <field name="mail_template_id"/>
                <field name="mass_mailing_id"/>
                <field name="write_date"/>
                <templates>
                    <t t-name="card">
                        <!-- Colour strip -->
                        <div t-attf-style="
                            height:5px;margin:-12px -12px 12px;
                            background:#{
                                record.state.raw_value == 'tested' ? '#10b981' :
                                record.state.raw_value == 'ready' ? '#3b82f6' :
                                record.state.raw_value == 'draft' ? '#f59e0b' : '#8b5cf6'
                            };border-radius:8px 8px 0 0;"/>

                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <strong class="fs-6 text-truncate" style="max-width:75%;">
                                <field name="name"/>
                            </strong>
                            <field name="state" widget="badge"
                                   decoration-success="state in ('ready','tested')"
                                   decoration-warning="state == 'draft'"
                                   class="ms-2 flex-shrink-0"/>
                        </div>

                        <div t-if="record.subject.value"
                             class="text-muted small mb-2"
                             style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            <field name="subject"/>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span t-if="record.model.value" class="text-muted small">
                                <i class="fa fa-database me-1" title="Model"/><field name="model"/>
                            </span>
                        </div>

                        <!-- Badges -->
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span t-if="record.mail_template_id.raw_value"
                                  class="badge text-bg-success">
                                <i class="fa fa-link me-1" title="Synced"/>Synced
                            </span>
                            <span t-if="record.mass_mailing_id.raw_value"
                                  class="badge text-bg-info">
                                <i class="fa fa-bullhorn me-1" title="Mailing"/>Mailing
                            </span>
                        </div>

                        <!-- Footer -->
                        <div class="d-flex align-items-center justify-content-between border-top pt-2 mt-auto">
                            <span class="text-muted small">
                                <i class="fa fa-clock-o me-1" title="Last Updated"/><field name="write_date" widget="date"/>
                            </span>
                            <div class="d-flex flex-shrink-0 gap-1">
                                <a t-if="!record.mail_template_id.raw_value"
                                   name="action_generate_template"
                                   type="object"
                                   class="btn btn-sm btn-outline-primary"
                                   role="button"
                                   onclick="event.stopPropagation()">
                                    <i class="fa fa-bolt me-1" title="Generate"/>Generate
                                </a>
                                <a t-if="record.mail_template_id.raw_value"
                                   name="action_generate_template"
                                   type="object"
                                   class="btn btn-sm btn-outline-secondary"
                                   role="button"
                                   onclick="event.stopPropagation()">
                                    <i class="fa fa-refresh me-1" title="Re-Sync"/>Re-Sync
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_mcp_email_template" model="ir.actions.act_window">
        <field name="name">Email Templates</field>
        <field name="res_model">mcp.email.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No email templates yet
            </p>
            <p>
                Ask the AI assistant to create an email template.
                It will generate the HTML and save it here automatically.
            </p>
        </field>
    </record>

</odoo>