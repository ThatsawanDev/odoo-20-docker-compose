<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_jsn_service" model="res.groups.privilege">
        <field name="name">Service ERP</field><field name="sequence">15</field>
    </record>
    <record id="group_jsn_technician" model="res.groups">
        <field name="name">ช่างเทคนิค</field><field name="privilege_id" ref="privilege_jsn_service"/>
        <field name="implied_ids" eval="[(4, ref('machine_service_management.group_machine_service_user'))]"/>
    </record>
    <record id="group_jsn_warehouse" model="res.groups">
        <field name="name">คลังอะไหล่</field><field name="privilege_id" ref="privilege_jsn_service"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_jsn_service" model="res.groups">
        <field name="name">ฝ่ายบริการ</field><field name="privilege_id" ref="privilege_jsn_service"/>
        <field name="implied_ids" eval="[(4, ref('machine_service_management.group_machine_service_user')), (4, ref('stock.group_stock_user')), (4, ref('sales_team.group_sale_salesman')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_jsn_admin" model="res.groups">
        <field name="name">ผู้ดูแลระบบบริการ</field><field name="privilege_id" ref="privilege_jsn_service"/>
        <field name="implied_ids" eval="[(4, ref('group_jsn_service')), (4, ref('group_jsn_warehouse')), (4, ref('machine_service_management.group_machine_service_manager')), (4, ref('account.group_account_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
